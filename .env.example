# Local SQLite database. Layero supplies LAYERO_DATABASE_URL after a PostgreSQL database is connected.
DATABASE_URL="file:./dev.db"
# OpenAI-compatible provider selection: mock or openai
LLM_PROVIDER="mock"
# OpenAI-compatible API key; required only when LLM_PROVIDER=openai
LLM_API_KEY=""
# Provider base URL, for example https://api.openai.com/v1
LLM_BASE_URL="https://api.openai.com/v1"
# Chat Completions model identifier
LLM_MODEL="gpt-4o-mini"
# Admin login name, set on first startup
ADMIN_USERNAME="admin"
# Bcrypt-compatible admin password, replace before exposing the service
ADMIN_PASSWORD="change-this-password"
# Optional bcrypt hash; when set it takes precedence over ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=""
# Signing secret for secure admin sessions, use a random value of at least 32 characters
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Comma-separated allowed embedding website origins
ALLOWED_ORIGINS="http://localhost:3000"
# SMTP settings for email notifications (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Telegram bot token and administrator chat ID (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
# Public base URL used in customer booking emails and cancellation links
APP_BASE_URL="http://localhost:3000"
# Shared secret for the internal reminder scanner and its API endpoint
CRON_SECRET="replace-with-a-separate-random-secret"
# Internal application URL used by the periodic reminder scanner
INTERNAL_BASE_URL="http://127.0.0.1:3000"
